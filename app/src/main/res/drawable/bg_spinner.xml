<?xml version="1.0" encoding="utf-8"?>
<!-- Latar Spinner: kotak putih berbucu 12dp + garis halus + anak panah di hujung.
     Sama rupa dengan medan TextInputLayout supaya borang nampak seragam. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke
                android:width="1dp"
                android:color="@color/text_secondary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:width="24dp"
        android:height="24dp"
        android:drawable="@drawable/ic_arrow_drop_down"
        android:end="12dp"
        android:gravity="end|center_vertical" />
</layer-list>
