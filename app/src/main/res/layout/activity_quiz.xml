<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Root = anchor Snackbar. Java paparkan SATU daripada tiga keadaan:
         progress_loading, group_error atau group_quiz. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_quiz"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".QuizActivity">

        <!-- Keadaan 1: loading -->
        <ProgressBar
            android:id="@+id/progress_loading"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Keadaan 2: ralat. Mesej + butang dipusatkan sebagai satu kumpulan
             (vertical chain "packed"). -->
        <TextView
            android:id="@+id/tv_error_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/text_primary"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@id/btn_retry"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_max="480dp"
            tools:text="@string/error_not_enough_questions" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minHeight="56dp"
            android:text="@string/btn_retry"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_error_message" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:constraint_referenced_ids="tv_error_message,btn_retry" />

        <!-- Keadaan 3: kuiz. Semua widget kuiz berada dalam scroll_quiz supaya
             boleh di-scroll bila skrin pendek (landscape). group_quiz
             menunjuk/menyembunyikan scroll_quiz, jadi semua anaknya ikut sekali. -->
        <ScrollView
            android:id="@+id/scroll_quiz"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Lajur kandungan. Mendatar: lebar dihadkan 560dp + layout_gravity="center_horizontal".
                 Menegak: fillViewport meregangkan lajur setinggi skrin bila kandungan pendek,
                 dan vertical chain "packed" (tv_question_counter ... btn_next) memusatkan
                 kandungan. Bila kandungan lebih tinggi (landscape), ia bermula dari atas dan
                 boleh di-scroll sepenuhnya. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:maxWidth="560dp"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_question_counter"
                    app:layout_constraintBottom_toTopOf="@id/progress_quiz"
                    app:layout_constraintVertical_chainStyle="packed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/text_secondary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Soalan 3/10" />

                <TextView
                    android:id="@+id/tv_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    app:layout_constraintBaseline_toBaselineOf="@id/tv_question_counter"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="Skor: 2" />

                <ProgressBar
                    android:id="@+id/progress_quiz"
                    app:layout_constraintBottom_toTopOf="@id/tv_category"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="10"
                    android:progressBackgroundTint="@color/progress_track"
                    android:progressTint="@color/accent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_question_counter"
                    tools:progress="3" />

                <TextView
                    android:id="@+id/tv_category"
                    app:layout_constraintBottom_toTopOf="@id/card_question"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/accent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/progress_quiz"
                    tools:text="Computers" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_question"
                    app:layout_constraintBottom_toTopOf="@id/iv_feedback"
                    style="?attr/materialCardViewOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/progress_track"
                    app:strokeWidth="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_category">

                    <TextView
                        android:id="@+id/tv_question"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minHeight="96dp"
                        android:padding="20dp"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="@color/text_primary"
                        tools:text="Which language is primarily used to style web pages?" />
                </com.google.android.material.card.MaterialCardView>

                <ImageView
                    android:id="@+id/iv_feedback"
                    app:layout_constraintBottom_toTopOf="@id/btn_option_1"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:contentDescription="@string/cd_feedback"
                    android:src="@drawable/ic_neutral"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/card_question" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_option_1"
                    app:layout_constraintBottom_toTopOf="@id/btn_option_2"
                    style="@style/Widget.SmartTriviaHub.Button.Option"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_feedback"
                    tools:text="CSS" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_option_2"
                    app:layout_constraintBottom_toTopOf="@id/btn_option_3"
                    style="@style/Widget.SmartTriviaHub.Button.Option"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_option_1"
                    tools:text="HTML" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_option_3"
                    app:layout_constraintBottom_toTopOf="@id/btn_option_4"
                    style="@style/Widget.SmartTriviaHub.Button.Option"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_option_2"
                    tools:text="JavaScript" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_option_4"
                    app:layout_constraintBottom_toTopOf="@id/btn_next"
                    style="@style/Widget.SmartTriviaHub.Button.Option"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_option_3"
                    tools:text="SQL" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_next"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="56dp"
                    android:text="@string/btn_next"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_option_4" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_quiz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="scroll_quiz" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
