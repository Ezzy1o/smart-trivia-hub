<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Satu baris breakdown. Di-inflate oleh ResultActivity untuk setiap soalan. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_item_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="1." />

        <TextView
            android:id="@+id/tv_item_question"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@id/iv_item_status"
            app:layout_constraintStart_toEndOf="@id/tv_item_number"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Teks soalan yang panjang akan dibungkus ke baris seterusnya" />

        <ImageView
            android:id="@+id/iv_item_status"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/cd_item_status"
            android:src="@drawable/ic_neutral"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_item_your_answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="@id/tv_item_question"
            app:layout_constraintStart_toStartOf="@id/tv_item_question"
            app:layout_constraintTop_toBottomOf="@id/tv_item_question"
            tools:text="Jawapan anda: ..." />

        <TextView
            android:id="@+id/tv_item_correct_answer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="@id/tv_item_question"
            app:layout_constraintStart_toStartOf="@id/tv_item_question"
            app:layout_constraintTop_toBottomOf="@id/tv_item_your_answer"
            tools:text="Jawapan betul: ..." />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
