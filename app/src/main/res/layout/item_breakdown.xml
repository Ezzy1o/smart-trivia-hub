<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Satu kad breakdown. ResultActivity inflate satu untuk setiap soalan dan tambah
         ke layout_breakdown. Teks soalan dibungkus (wrap) ke baris seterusnya. -->
    <com.google.android.material.card.MaterialCardView
        style="?attr/materialCardViewOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="12dp"
        app:strokeColor="@color/progress_track"
        app:strokeWidth="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_item_number"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_number_badge"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="@color/on_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="1" />

            <TextView
                android:id="@+id/tv_item_question"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/iv_item_status"
                app:layout_constraintStart_toEndOf="@id/tv_item_number"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Which language is primarily used to style web pages and control their layout?" />

            <ImageView
                android:id="@+id/iv_item_status"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/cd_item_status"
                android:src="@drawable/ic_neutral"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_item_your_answer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/text_primary"
                app:layout_constraintEnd_toEndOf="@id/tv_item_question"
                app:layout_constraintStart_toStartOf="@id/tv_item_question"
                app:layout_constraintTop_toBottomOf="@id/tv_item_question"
                tools:text="Jawapan anda: HTML" />

            <TextView
                android:id="@+id/tv_item_correct_answer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/correct"
                app:layout_constraintEnd_toEndOf="@id/tv_item_question"
                app:layout_constraintStart_toStartOf="@id/tv_item_question"
                app:layout_constraintTop_toBottomOf="@id/tv_item_your_answer"
                tools:text="Jawapan betul: CSS" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
